{
  "name": "paycycle-api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "tsc",
    "lint": "eslint .",
    "check": "tsc --noEmit",
    "d1:migrate:local": "wrangler d1 migrations apply paycycle-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply paycycle-db --remote"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "@eslint/js": "^9.25.0",
    "@types/node": "^22.15.30",
    "eslint": "^9.25.0",
    "globals": "^16.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "wrangler": "^4.86.0"
  }
}
